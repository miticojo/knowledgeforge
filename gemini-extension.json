{
  "name": "knowledgeforge",
  "version": "0.1.0",
  "description": "AgenticRAG over GraphRAG — query enterprise architecture knowledge built from your documents",
  "mcpServers": {
    "knowledgeforge": {
      "command": "kb-mcp",
      "args": ["serve", "--backend-url", "${BACKEND_URL}"],
