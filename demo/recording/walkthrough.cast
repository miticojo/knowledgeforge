[42.846, "o", "  [t+ 25s] status=complete\r\n\r\n  \u2713 ingestion complete\r\n"]
[45.854, "o", "\u001b[2;37m  Single Python repo \u2192 AST nodes \u2192 entities \u2192 graph edges, all in Spanner.\u001b[0m\r\n"]
[47.858, "o", "\r\n\u001b[1;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[47.858, "o", "\u001b[1;36m  STEP 3 \u2014 /graph/stats: how big is the graph we just built?\u001b[0m\r\n"]
