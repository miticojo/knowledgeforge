[13.625, "o", "ealization ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ('__sh...\r\n[init_emulator]   [tenant 31/39] applied        \u2014 ALTER TABLE Serving ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ('__shared...\r\n[init_emulator]   [tenant 32/39] applied        \u2014 ALTER TABLE Access ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ('__shared_...\r\n[init_emulator]   [tenant 33/39] applied        \u2014 ALTER TABLE Triggering ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ('__sha...\r\n[init_emulator]   [tenant 34/39] applied        \u2014 ALTER TABLE Flow ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ('__shared__'...\r\n[init_emulator]   [tenant 35/39] applied        \u2014 ALTER TABLE Influence ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ('__shar...\r\n[init_emulator]   [tenant 36/39] applied        \u2014 ALTER TABLE Association ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ('__sh...\r\n[init_emulator]   [tenant 37/39] applied        \u2014 ALTER TABLE Specialization ADD COLUMN tenant_id STRING(320) NOT NULL DEFAULT ("]
[13.625, "o", "'_...\r\n[init_emulator]   [tenant 38/39] applied        \u2014 CREATE INDEX Idx_Documents_TenantId ON Documents(tenant_id)\r\n[init_emulator]   [tenant 39/39] applied        \u2014 CREATE INDEX Idx_DocumentChunks_TenantId ON DocumentChunks(tenant_id)\r\n[init_emulator]   tenant: applied=39 skipped-duplicate=0 errors=0\r\n[init_emulator] Done. Totals: applied=77 skipped-duplicate=15 errors=0\r\n[init_emulator] Emulator init complete.\r\n"]
[16.632, "o", "\u001b[2;37m  Schema applied. Now ingest a real Python library from GitHub.\u001b[0m\r\n"]
[18.655, "o", "\r\n\u001b[1;33m\u2192 Kick off git ingestion: clone, parse, extract, write graph\u001b[0m\r\n"]
[19.663, "o", "\u001b[2m$ curl -X POST http://localhost:8090/ingest/git -d '{repo_url:\"https://github.com/pallets/itsdangerous\", ...}'\u001b[0m\r\n"]
[19.7, "o", "  job_id=a4c6b14fd37e4250863036251a82e66a\r\n"]
[21.709, "o", "\r\n\u001b[1;33m\u2192 Poll the job until it reports 'complete'\u001b[0m\r\n"]
