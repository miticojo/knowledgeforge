# Backend (kb-agent) base URL — local dev or Cloud Run URL
BACKEND_URL=http://localhost:8080

# LiteParse service (PDF text + image extraction). Required for PDF uploads.
LITEPARSE_URL=https://your-liteparse-service.run.app

# ─── Firebase auth (multi-tenant mode) ───────────────────────────────────
# Leave all NEXT_PUBLIC_FIREBASE_* vars empty/unset for single-tenant dev mode.
# When unset, AuthProvider auto-injects a "demo@local" user and all requests
# go out with X-Tenant-Id: demo@local.
#
# When set, users must sign in with Google; their email becomes the tenant_id
# carried on every backend request via the X-Tenant-Id header.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Optional comma-separated allowlist of email addresses permitted to sign in.
# If empty, any Google account is accepted.
NEXT_PUBLIC_ALLOWED_EMAILS=
