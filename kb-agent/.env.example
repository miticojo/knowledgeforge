# --- GCP ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=europe-west1
VERTEX_AI_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=1

# --- Cloud Spanner (graph + vector store) ---
SPANNER_PROJECT=your-gcp-project          # often same as GOOGLE_CLOUD_PROJECT
SPANNER_INSTANCE=your-spanner-instance
SPANNER_DATABASE=your-spanner-database

# --- Document parsing service (Cloud Run, see liteparse-service/) ---
DOCLING_URL=https://your-docling-service.run.app

# --- Retrieval tuning ---
RECONCILIATION_THRESHOLD=0.15             # entity merge cosine-distance threshold

# --- Security (optional) ---
ENABLE_MODEL_ARMOR=false
# MODEL_ARMOR_TEMPLATE_ID=projects/your-gcp-project/locations/europe-west1/templates/your-template

# --- Runtime ---
PORT=8080
ENV=development

# --- Optional: Google Data Agent Kit MCP toolboxes (require Node.js for npx) ---
KC_TOOLBOX_ENABLED=false
BQ_TOOLBOX_ENABLED=false
DATAPLEX_PROJECT=                  # required if KC_TOOLBOX_ENABLED
BIGQUERY_PROJECT=                  # required if BQ_TOOLBOX_ENABLED
BIGQUERY_LOCATION=                 # required if BQ_TOOLBOX_ENABLED

# --- Milestone B: Knowledge Catalog (Dataplex) exporter (opt-in) ---
# When enabled, services/kc_exporter.py projects the KF graph (DataObject +
# Access/Realization edges) into Google Knowledge Catalog as Entry/Aspect/EntryLink.
# Reuses DATAPLEX_PROJECT above. Install extras: pip install -e ".[kc]"
KC_SYNC_ENABLED=false
KC_ENTRY_GROUP_ID=kf-import
KC_LOCATION=europe-west1

# --- Milestone C: Knowledge Catalog reverse importer (KC -> KF, opt-in) ---
# When enabled, services/kc_importer.py pulls KC Entries (BigQuery tables,
# Spanner databases, etc.) into the KF graph as ArchiMate DataObjects, either
# on demand (--once) or by consuming a Pub/Sub change feed (streaming).
KC_IMPORT_ENABLED=false
KC_IMPORT_SUBSCRIPTION=               # required if KC_IMPORT_ENABLED, e.g. projects/foo/subscriptions/kc-changes

# --- Milestone D: Knowledge Catalog Glossary bridge (BusinessObject <-> Term) ---
KC_GLOSSARY_ID=kf-glossary
