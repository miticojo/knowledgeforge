<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
    </parent>

    <groupId>com.archisurance</groupId>
    <artifactId>claims-service</artifactId>
    <version>2.1.0</version>
    <name>Claims Management Platform</name>
    <description>
        Microservice for Claims Registration and Claims Assessment.
        Part of the ArchiSurance Application Portfolio.
        Deployed on Kubernetes (App Server Cluster).
        Uses PostgreSQL 15 for persistence and Apache Kafka for event streaming.
    </description>

    <dependencies>
        <!-- Spring Boot Web (ApplicationComponent runtime) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- JPA for PostgreSQL 15 access (SystemSoftware dependency) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>
        <!-- Apache Kafka for event streaming (SystemSoftware dependency) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Redis for caching (SystemSoftware dependency) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
